#!/usr/bin/env bash
# Создание пользователя live-системы MyOS. Пользователь: myos, пароль: myos.
set -u

if ! id myos >/dev/null 2>&1; then
    useradd -m -c "MyOS" \
        -G wheel,video,audio,input,storage,optical,network,power \
        -s /bin/bash myos
fi

# Пароль фиксированный: удобно для live-сессии, внутри установленной системы
# пользователь создаётся заново с паролем, который вводит установщик.
echo 'myos:myos' | chpasswd

passwd -l root >/dev/null 2>&1 || true

echo 'myos ALL=(ALL:ALL) NOPASSWD: ALL' > /etc/sudoers.d/10-myos-live
chmod 440 /etc/sudoers.d/10-myos-live

# Иконка установщика на рабочем столе live-сессии.
DESKTOP_FILE=/usr/share/applications/myos-installer.desktop
if [ -f "$DESKTOP_FILE" ]; then
    for sub in "Desktop" "Рабочий стол"; do
        install -d -o myos -g myos "/home/myos/$sub" 2>/dev/null || continue
        install -m755 -o myos -g myos "$DESKTOP_FILE" \
            "/home/myos/$sub/Установить MyOS.desktop" 2>/dev/null || true
    done
fi

echo "[myos] live user готов (пользователь myos / пароль myos)"
